# Copiá este archivo a .env.local. Sin ninguna variable, la app corre en modo demo
# (datos generados en el navegador y resumen calculado con reglas, sin IA).

# --- IA (solo servidor) ---
# Activa el resumen con Claude. Nunca con prefijo NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
# Tope global de llamadas a Claude por día (protege el costo de la demo pública).
AI_GLOBAL_DAILY_CAP=200

# --- Firebase (cliente, públicas por diseño) ---
# Si están completas, el panel lee de Firestore y usa Firebase Auth.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (solo servidor) ---
# JSON de la cuenta de servicio, en base64 (una línea):
#   base64 -w0 service-account.json
FIREBASE_SERVICE_ACCOUNT_BASE64=
